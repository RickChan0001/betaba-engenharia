---
import { getCollection } from 'astro:content';
const todas = await getCollection('noticias');
const noticias = todas
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---
<section id="noticias" class="py-24 md:py-32">
  <div class="mx-auto w-full max-w-[1400px] px-4 md:px-5 lg:px-6">

    <div class="grid lg:grid-cols-12 gap-12 mb-16">
      <div class="lg:col-span-5">
        <p class="label-caps mb-6">03 — Notícias</p>
        <h2 class="section-title">Em campo.</h2>
      </div>
      <div class="lg:col-span-7 lg:pt-12">
        <p class="section-subtitle">
          Acompanhe nossos projetos e novidades no litoral do Paraná.
        </p>
      </div>
    </div>

    {noticias.length === 0 ? (
      <p class="text-silver/60 italic py-12">
        Nenhuma notícia publicada ainda.
      </p>
    ) : (
      <ul class="grid gap-px bg-silver/15 border border-silver/15 md:grid-cols-3">
        {noticias.map(n => (
          <li>
            <article class="bg-navy hover:bg-white transition-colors duration-300 h-full p-8 group">
              <time datetime={n.data.data.toISOString()}
                    class="text-xs uppercase tracking-wider text-steel-light group-hover:text-steel font-semibold">
                {fmt.format(n.data.data)} · {n.data.local}
              </time>
              <h3 class="mt-4 font-display font-bold text-lg text-silver group-hover:text-ink transition-colors leading-tight">
                {n.data.titulo}
              </h3>
              <p class="mt-3 text-sm text-silver/80 group-hover:text-graphite transition-colors leading-relaxed">
                {n.data.resumo}
              </p>
            </article>
          </li>
        ))}
      </ul>
    )}

  </div>
</section>