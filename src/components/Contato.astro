<section id="contato" class="py-20 md:py-28">
  <div class="container grid md:grid-cols-2 gap-16">
    <div>
      <h2 class="section-title">Vamos Construir Juntos</h2>
      <p class="mt-4 text-graphite/85 text-lg">
        Solicite um orçamento sem compromisso. Responderemos em até 24h úteis.
      </p>

      <ul class="mt-10 space-y-5">
        <li class="flex gap-4">
          <span aria-hidden="true" class="text-2xl">📱</span>
          <div>
            <strong class="block text-navy font-semibold">WhatsApp</strong>
            <a href="https://wa.me/5541999999999" class="text-steel hover:text-steel-light">
              (41) 99999-9999
            </a>
          </div>
        </li>
        <li class="flex gap-4">
          <span aria-hidden="true" class="text-2xl">✉️</span>
          <div>
            <strong class="block text-navy font-semibold">E-mail</strong>
            <a href="mailto:contato@betabaengenharia.com.br" class="text-steel hover:text-steel-light">
              contato@betabaengenharia.com.br
            </a>
          </div>
        </li>
        <li class="flex gap-4">
          <span aria-hidden="true" class="text-2xl">📍</span>
          <div>
            <strong class="block text-navy font-semibold">Atendimento</strong>
            <span class="text-graphite/80">Todo o litoral do Paraná</span>
          </div>
        </li>
      </ul>
    </div>

    <!-- action aponta para Formspree (grátis) - troque o ID depois -->
    <form
      action="https://formspree.io/f/SEU_ID_AQUI"
      method="POST"
      class="bg-white rounded-2xl p-8 border border-silver/40 shadow-sm space-y-5"
    >
      <div>
        <label for="nome" class="block text-sm font-semibold text-navy mb-1">Nome</label>
        <input id="nome" name="nome" required
          class="w-full px-4 py-3 rounded-lg border border-silver/60 focus:border-steel focus:ring-2 focus:ring-steel/20 outline-none" />
      </div>
      <div>
        <label for="email" class="block text-sm font-semibold text-navy mb-1">E-mail</label>
        <input id="email" name="email" type="email" required
          class="w-full px-4 py-3 rounded-lg border border-silver/60 focus:border-steel focus:ring-2 focus:ring-steel/20 outline-none" />
      </div>
      <div>
        <label for="msg" class="block text-sm font-semibold text-navy mb-1">Mensagem</label>
        <textarea id="msg" name="mensagem" rows="5" required
          class="w-full px-4 py-3 rounded-lg border border-silver/60 focus:border-steel focus:ring-2 focus:ring-steel/20 outline-none"></textarea>
      </div>
      <!-- honeypot anti-spam -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <button type="submit" class="btn-primary w-full justify-center">Enviar mensagem</button>
    </form>
  </div>
</section>
