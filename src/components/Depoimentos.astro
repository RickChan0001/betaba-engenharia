---
const depoimentos = [
  { nome: 'João P.', cidade: 'Guaratuba', texto: 'Entrega no prazo e qualidade impecável. Recomendo de olhos fechados.' },
  { nome: 'Marina S.', cidade: 'Pontal do Paraná', texto: 'Equipe atenciosa, orçamento transparente e resultado impecável.' },
  { nome: 'Construtora Litoral', cidade: 'Paranaguá', texto: 'Parceria sólida em obras de infraestrutura. Profissionalismo total.' }
];
---
<section class="py-20 md:py-28 bg-navy text-white">
  <div class="container">
    <header class="text-center mb-16">
      <h2 class="font-display text-3xl md:text-5xl font-extrabold tracking-tight">
        O Que Dizem Nossos Clientes
      </h2>
    </header>

    <ul class="grid gap-6 md:grid-cols-3">
      {depoimentos.map(d => (
        <li class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur">
          <p class="text-silver leading-relaxed italic">"{d.texto}"</p>
          <footer class="mt-4 pt-4 border-t border-white/10">
            <strong class="text-white font-semibold block">{d.nome}</strong>
            <span class="text-sm text-silver/70">{d.cidade}</span>
          </footer>
        </li>
      ))}
    </ul>
  </div>
</section>
