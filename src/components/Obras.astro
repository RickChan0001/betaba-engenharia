---
import { getCollection } from 'astro:content';
const obras = await getCollection('obras');
const destaques = obras.filter(o => o.data.destaque).slice(0, 6);
---
<section id="obras" class="py-20 md:py-28">
  <div class="container">
    <header class="text-center mb-16">
      <h2 class="section-title">Obras Realizadas</h2>
      <p class="section-subtitle mt-4">
        Conheça alguns dos projetos que entregamos no litoral paranaense.
      </p>
    </header>

    {destaques.length === 0 ? (
      <p class="text-center text-graphite/60 italic">
        Em breve, novas obras em destaque. Volte em breve!
      </p>
    ) : (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {destaques.map(o => (
          <li class="group relative overflow-hidden rounded-xl aspect-[4/3] bg-navy">
            <img
              src={o.data.imagem}
              alt={`Obra: ${o.data.titulo} em ${o.data.local}`}
              loading="lazy" decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/40 to-transparent"></div>
            <div class="absolute bottom-0 inset-x-0 p-5 text-white">
              <span class="inline-block text-xs font-semibold uppercase tracking-wider text-silver bg-navy/60 px-2 py-1 rounded">
                {o.data.categoria}
              </span>
              <h3 class="mt-2 font-display font-bold text-lg">{o.data.titulo}</h3>
              <p class="text-sm text-silver/90">{o.data.local} · {o.data.ano}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
