---
const servicos = [
  { titulo: 'Levantamento Planialtimétrico', desc: 'Registro preciso de dimensões, limites, altimetria e características físicas do terreno.', path: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
  { titulo: 'Georreferenciamento', desc: 'Vinculação do imóvel ao Sistema Geodésico Brasileiro com coordenadas reconhecidas em cartório.', path: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064' },
  { titulo: 'Locação de Obra', desc: 'Implantação da construção exatamente no lugar previsto em projeto, com marcos e piquetes.', path: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z' },
  { titulo: 'Levantamento com Drone', desc: 'Mapeamento aéreo, geração de modelos 3D e ortofotos para grandes áreas.', path: 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8' },
  { titulo: 'Nivelamento', desc: 'Determinação de diferenças de altura entre pontos para projetos de terraplanagem e drenagem.', path: 'M4 6h16M4 12h16M4 18h16' },
  { titulo: 'Topografia para Infraestrutura', desc: 'Levantamentos para projetos viários, loteamentos, drenagem e obras urbanas.', path: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' }
];
---
<section id="servicos" class="py-24 md:py-32">
  <div class="mx-auto w-full max-w-[1400px] px-4 md:px-5 lg:px-6">

    <div class="grid lg:grid-cols-12 gap-12 mb-16">
      <div class="lg:col-span-5">
        <p class="label-caps mb-6">02 — Serviços</p>
        <h2 class="section-title">O que fazemos.</h2>
      </div>
      <div class="lg:col-span-7 lg:pt-12">
        <p class="section-subtitle">
          Soluções completas em topografia e georreferenciamento para o litoral do Paraná —
          do levantamento inicial à regularização em cartório.
        </p>
      </div>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-silver/15 border border-silver/15">
      {servicos.map((s, i) => (
        <li class="group bg-navy hover:bg-white p-8 lg:p-10 transition-colors duration-300">
          <div class="flex items-start justify-between mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.25"
                 stroke-linecap="round" stroke-linejoin="round"
                 class="w-8 h-8 text-steel group-hover:text-steel transition-colors"
                 aria-hidden="true">
              <path d={s.path} />
            </svg>
            <span class="text-xs font-mono text-silver/40 group-hover:text-ink/40 transition-colors">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="font-display font-bold text-lg text-silver group-hover:text-ink transition-colors leading-tight">
            {s.titulo}
          </h3>
          <p class="mt-3 text-sm text-silver/85 group-hover:text-graphite transition-colors leading-relaxed">
            {s.desc}
          </p>
        </li>
      ))}
    </ul>

  </div>
</section>