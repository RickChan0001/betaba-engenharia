---
const links = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#servicos', label: 'Serviços' },
  { href: '#noticias', label: 'Notícias' },
  { href: '#contato', label: 'Contato' }
];
---
<header class="fixed top-0 inset-x-0 z-50 bg-navy/70 backdrop-blur-md border-b border-silver/10">
  <div class="mx-auto w-full max-w-[1400px] px-4 md:px-5 lg:px-6 flex items-center justify-between h-20">
    <a href="#top" class="flex items-center gap-3" aria-label="BETABA Engenharia - Início">
      <img src="/logo-betaba.png" alt="" width="36" height="36" class="h-9 w-auto" />
      <span class="font-display font-bold text-silver tracking-tight text-base hidden sm:block">
        BETABA <span class="text-silver/60 font-normal">ENGENHARIA</span>
      </span>
    </a>

    <nav aria-label="Navegação principal" class="hidden md:flex items-center gap-10">
      {links.map(l => (
        <a href={l.href}
           class="text-silver/80 hover:text-silver text-sm font-medium tracking-wide transition-colors">
          {l.label}
        </a>
      ))}
    </nav>

    <a
      href="https://wa.me/554191875514?text=Ol%C3%A1%2C%20quero%20um%20or%C3%A7amento"
      target="_blank" rel="noopener"
      class="btn-primary !px-5 !py-2.5"
    >
      Orçamento
    </a>
  </div>
</header>