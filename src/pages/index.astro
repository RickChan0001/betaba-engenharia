---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Servicos from '../components/Servicos.astro';
import Obras from '../components/Obras.astro';
import Noticias from '../components/Noticias.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---
<Base
  title="BETABA Engenharia — Construindo o Futuro, Juntos"
  description="Engenharia civil de qualidade no litoral do Paraná. Obras residenciais, comerciais, infraestrutura e reformas com prazos respeitados."
>
  <Header />
  <main>
    <Hero />
    <Sobre />
    <Servicos />
    <Obras />
    <Noticias />
    <Depoimentos />
    <Contato />
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>
